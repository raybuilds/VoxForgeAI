# ==============================================================================
# VoxForgeAI Environment Configuration Example
# ==============================================================================
# Copy this file to .env.local to configure your private credentials.
# NEVER commit .env.local or your actual API keys to version control.
# ==============================================================================

# Google Gemini API Key for natural language agent synthesis & conversational refinement
# Obtain your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Google Gemini model identifier (defaults to gemini-2.5-flash with automatic fallback)
GEMINI_MODEL=gemini-2.5-flash

# ElevenLabs API Key for conversational agent creation, voice synthesis, signed URLs & audio telemetry
# Obtain your API key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
